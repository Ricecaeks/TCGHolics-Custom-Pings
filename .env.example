# Copy to .env and fill in. Every node uses the same values except NODE_NAME.

# Unique per machine (nuc1, nuc2, ...). Defaults to the hostname if unset.
NODE_NAME=nuc1

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (port 5432).
# Never use the transaction pooler (port 6543): leader election needs session-level locks.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_SIZE=4

# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Right-click the server / role / channel with Developer Mode on -> Copy ID
GUILD_ID=
STAFF_ROLE_ID=
# Optional: channel for node/adapter health warnings
LOG_CHANNEL_ID=

# Optional comma-separated proxy URLs, e.g. http://user:pass@proxy.example.com:8000
# Retailers only use them when their proxy policy is "pool" or "sticky".
PROXY_URLS=

# Tuning (defaults shown)
WORKER_CONCURRENCY=8
RETENTION_DAYS=30
BACKUP_ENABLED=true
LOG_LEVEL=INFO
